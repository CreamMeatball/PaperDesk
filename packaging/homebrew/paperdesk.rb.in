# Rendered by scripts/release.py. Do not edit Formula/paperdesk.rb by hand.
class Paperdesk < Formula
  include Language::Python::Virtualenv

  desc "Local AI paper reader with pluggable assistants"
  homepage "@HOMEPAGE@"
  url "@URL@"
  sha256 "@SHA256@"
@LICENSE_LINE@
  depends_on :macos
  depends_on "python@3.13"

  # Native window dependencies (pywebview + PyObjC). Regenerate on a Mac after changing versions:
  #   brew update-python-resources --print-only Formula/paperdesk.rb
  # and paste the output here (setuptools first, because Homebrew builds without isolation).
@RESOURCES@
  def install
    virtualenv_install_with_resources
  end

  def caveats
    <<~EOS
      Open the app with:
        paperdesk
      Library data lives in ~/Library/Application Support/Paperdesk.
      Let Claude Desktop or Codex read your papers over MCP:
        paperdesk mcp-config claude
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/paperdesk --version")
    ENV["PAPERDESK_HOME"] = (testpath/"data").to_s
    report = JSON.parse(shell_output("#{bin}/paperdesk doctor --json"))
    assert_equal "macos", report["platform"]
  end
end

